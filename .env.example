# =============================================================================
# Satellite Agronomy Intelligence Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# PostgreSQL (agri_platform database)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/agri_platform

# Firebase / Firestore
FIREBASE_PROJECT_ID=your-firebase-project-id

# JWT (Flask-JWT-Extended)
JWT_SECRET_KEY=supersecretkey_change_in_production

# Flask
FLASK_PORT=5000
FLASK_ENV=development

# Google Earth Engine (existing)
GEE_PROJECT_ID=your-gee-project-id

# ─────────────────────────────────────────────────────────────────────────────
# Go backend additions (PRD §9.2)
# ─────────────────────────────────────────────────────────────────────────────
# Path to a GCP service-account JSON key registered for Earth Engine.
# This is the production path (objective O7 — no interactive browser OAuth).
GEE_SERVICE_ACCOUNT_KEY=./gee-service-account.json

# Optional dev fallback: reuse the credentials `earthengine authenticate` wrote.
# NOTE: that file contains only refresh_token / redirect_uri / scopes — the
# client_id and client_secret come from the earthengine-api library constants.
# GEE_USER_CREDENTIALS=~/.config/earthengine/credentials

# Existing keys still consumed by the Go server (unchanged names):
#   DATABASE_URL, FIREBASE_PROJECT_ID, JWT_SECRET_KEY, FLASK_PORT, FLASK_ENV,
#   GEE_PROJECT_ID, OLLAMA_BASE_URL, OLLAMA_MODEL, OLLAMA_TEMPERATURE,
#   OLLAMA_MAX_TOKENS, CHATBOT_MAX_HISTORY,
#   SMS_USERNAME, SMS_PASSWORD, SMS_FROM, SMS_DLT_CONTENT_ID, SMS_DLT_PE_ID

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini — chatbot backend (replaces Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Setting GEMINI_API_KEY switches the chatbot to Gemini. Leave it empty to fall
# back to a local Ollama server (OLLAMA_BASE_URL / OLLAMA_MODEL below).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Reasoning-token budget for the 2.5 "thinking" models. It is shared with
# OLLAMA_MAX_TOKENS (the reply budget), so a non-zero value here can consume the
# whole allowance and return an empty answer. 0 disables thinking.
# GEMINI_THINKING_BUDGET=0

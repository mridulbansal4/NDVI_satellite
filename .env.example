# =============================================================================
# Satellite Agronomy Intelligence Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# PostgreSQL (agri_platform database)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/agri_platform

# Firebase / Firestore
FIREBASE_PROJECT_ID=your-firebase-project-id

# JWT (Flask-JWT-Extended)
#
# REQUIRED when FLASK_ENV=production — the server refuses to start without a
# real value of at least 32 characters. Token verification is deliberately
# liberal (any valid HS256 token with a `sub` is accepted, and that `sub` IS the
# farmer id), so a guessable key means anyone can mint a token for any account.
# Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=supersecretkey_change_in_production

# Flask
FLASK_PORT=5000
FLASK_ENV=development

# Google Earth Engine (existing)
GEE_PROJECT_ID=your-gee-project-id

# ─────────────────────────────────────────────────────────────────────────────
# Go backend additions (PRD §9.2)
# ─────────────────────────────────────────────────────────────────────────────
# Path to a GCP service-account JSON key registered for Earth Engine.
# This is the production path (objective O7 — no interactive browser OAuth).
GEE_SERVICE_ACCOUNT_KEY=./gee-service-account.json

# Optional dev fallback: reuse the credentials `earthengine authenticate` wrote.
# NOTE: that file contains only refresh_token / redirect_uri / scopes — the
# client_id and client_secret come from the earthengine-api library constants.
# GEE_USER_CREDENTIALS=~/.config/earthengine/credentials

# Existing keys still consumed by the Go server (unchanged names):
#   DATABASE_URL, FIREBASE_PROJECT_ID, JWT_SECRET_KEY, FLASK_PORT, FLASK_ENV,
#   GEE_PROJECT_ID, OLLAMA_BASE_URL, OLLAMA_MODEL, OLLAMA_TEMPERATURE,
#   OLLAMA_MAX_TOKENS, CHATBOT_MAX_HISTORY,
#   SMS_USERNAME, SMS_PASSWORD, SMS_FROM, SMS_DLT_CONTENT_ID, SMS_DLT_PE_ID

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini — chatbot backend (replaces Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Setting GEMINI_API_KEY switches the chatbot to Gemini. Leave it empty to fall
# back to a local Ollama server (OLLAMA_BASE_URL / OLLAMA_MODEL below).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# ─────────────────────────────────────────────────────────────────────────────
# Abuse limits
# ─────────────────────────────────────────────────────────────────────────────
# The analysis, auth and chatbot routes take no credentials and every call
# spends real money — Earth Engine quota, Gemini tokens, an SMS message, or
# 32 MB of scrypt per signup. These bound what one client IP can spend. The
# defaults are deliberately generous and are what the contract suite runs under;
# they exist to stop automated abuse, not to shape normal traffic.
#
# CORS_ORIGINS is comma-separated. It defaults to the localhost dev ports, so a
# DEPLOYED frontend must name its real origin here or the browser will block it.
# CORS_ORIGINS=https://app.example.com,http://localhost:5173
#
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MIN=120      # sustained requests/minute per client IP
# RATE_LIMIT_BURST=60         # burst allowance above the sustained rate
# ANALYZE_MAX_IN_FLIGHT=4     # concurrent Earth Engine analyses, process-wide
# MAX_REQUEST_BYTES=8388608   # 8 MiB hard cap on any request body
# OTP_MAX_ATTEMPTS=5          # wrong guesses before the OTP is discarded
# CHAT_MAX_SESSIONS=1000      # resident chatbot sessions before LRU eviction
#
# Reasoning-token budget for the 2.5 "thinking" models. It is shared with
# OLLAMA_MAX_TOKENS (the reply budget), so a non-zero value here can consume the
# whole allowance and return an empty answer. 0 disables thinking.
# GEMINI_THINKING_BUDGET=0
